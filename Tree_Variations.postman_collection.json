{
	"info": {
		"_postman_id": "tree-variations-collection-v2",
		"name": "Seller - Flat Variations (New API)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Seller Login (get token)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"phone\": \"01000000000\",\n    \"password\": \"password\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"login"
					]
				}
			}
		},
		{
			"name": "2. Store Variations (2 levels: Size → Color)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{seller_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"attributes\": [\"Size\", \"Color\"],\n    \"variations\": [\n        {\n            \"price\": 100,\n            \"quantity\": 15,\n            \"options\": {\n                \"Size\": \"M\",\n                \"Color\": \"Red\"\n            }\n        },\n        {\n            \"price\": 100,\n            \"quantity\": 10,\n            \"options\": {\n                \"Size\": \"M\",\n                \"Color\": \"Black\"\n            }\n        },\n        {\n            \"price\": 110,\n            \"quantity\": 20,\n            \"options\": {\n                \"Size\": \"L\",\n                \"Color\": \"Red\"\n            }\n        },\n        {\n            \"price\": 110,\n            \"quantity\": 5,\n            \"options\": {\n                \"Size\": \"L\",\n                \"Color\": \"Blue\"\n            }\n        }\n    ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}/variation-tree",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"products",
						"{{product_id}}",
						"variation-tree"
					]
				}
			}
		},
		{
			"name": "3. Get Variations (Tree Format)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{seller_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}/variation-tree",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"products",
						"{{product_id}}",
						"variation-tree"
					]
				}
			}
		},
		{
			"name": "4. Store Variations (3 levels: Size → Color → Material)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{seller_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"attributes\": [\"Size\", \"Color\", \"Material\"],\n    \"variations\": [\n        {\n            \"price\": 120,\n            \"quantity\": 10,\n            \"options\": {\n                \"Size\": \"M\",\n                \"Color\": \"Red\",\n                \"Material\": \"Cotton\"\n            }\n        },\n        {\n            \"price\": 95,\n            \"quantity\": 8,\n            \"options\": {\n                \"Size\": \"M\",\n                \"Color\": \"Red\",\n                \"Material\": \"Polyester\"\n            }\n        },\n        {\n            \"price\": 120,\n            \"quantity\": 12,\n            \"options\": {\n                \"Size\": \"M\",\n                \"Color\": \"Black\",\n                \"Material\": \"Cotton\"\n            }\n        },\n        {\n            \"price\": 130,\n            \"quantity\": 25,\n            \"options\": {\n                \"Size\": \"L\",\n                \"Color\": \"Red\",\n                \"Material\": \"Cotton\"\n            }\n        }\n    ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}/variation-tree",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"products",
						"{{product_id}}",
						"variation-tree"
					]
				}
			}
		},
		{
			"name": "5. Store Simple Variations (1 level only)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{seller_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"attributes\": [\"Color\"],\n    \"variations\": [\n        {\n            \"price\": 80,\n            \"quantity\": 50,\n            \"options\": {\n                \"Color\": \"Red\"\n            }\n        },\n        {\n            \"price\": 80,\n            \"quantity\": 30,\n            \"options\": {\n                \"Color\": \"Blue\"\n            }\n        },\n        {\n            \"price\": 85,\n            \"quantity\": 20,\n            \"options\": {\n                \"Color\": \"Green\"\n            }\n        }\n    ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}/variation-tree",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"products",
						"{{product_id}}",
						"variation-tree"
					]
				}
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/seller",
			"type": "string"
		},
		{
			"key": "seller_token",
			"value": "YOUR_SELLER_TOKEN_HERE",
			"type": "string"
		},
		{
			"key": "product_id",
			"value": "1",
			"type": "string"
		}
	]
}
