					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.result && jsonData.result.token) {",
									"    pm.collectionVariables.set('token', jsonData.result.token);",
									"    console.log('Token saved!');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"96551110001\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/seller/login",
							"host": ["{{base_url}}"],
							"path": ["seller", "login"]
						}
					}
				},
