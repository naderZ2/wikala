# Laravel Reverb (WebSocket server for real-time driver tracking)
# Generate credentials once: php artisan reverb:install   (or set any unique values)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public host/port the browser/mobile client connects to:
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Local server bind (the `php artisan reverb:start` process):
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Frontend (Laravel Echo) build-time vars:
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

